VITE_GA4_MEASUREMENT_ID=G-CFXQ8JPE21
# Optional. Comma list of Meta conversion events to send (exact names; unknown values are ignored).
# Default when unset: ViewContent,Contact. Lead and Schedule stay off until browser/server dedupe is verified.
# VITE_META_CONVERSIONS=ViewContent,Contact

# Server-only settings. Set these in the hosting provider secret store; never use a VITE_ prefix for them.
# Values are intentionally blank in this example.
# GoHighLevel inbound webhook URL for website leads. When blank, the built-in fallback is used.
GHL_WEBHOOK_URL=
# Backend project used by server code to store and forward leads.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_ROLE_KEY=
